# Build output. configure and Makefile.in are upstream-tracked, so only what
# a build produces is ignored here.
*.o
*.a
*.lo
*.la
.deps/
.libs/
Makefile
avian-miner
# One backend library per vendor, built from the same kernels and loaded at
# run time rather than linked, so they are build output that has to sit
# beside the binary.
libavian_cuda.so
libavian_amd.so
libavian_ocl.so
# The OpenCL tests are check_PROGRAMS, and its kernels are assembled
# into one header at build time.
avian-ocl-selftest
avian-ocl-batchtest
cuda/ocl/avian-ocl-kernels.h
# webui/index.html, likewise embedded into a header at build time.
avian-webui
webui/avian-webui-page.h
.dirstamp
configure~
cpuminer-config.h
cpuminer-config.h.in~
config.log
config.status
stamp-h1
autom4te.cache/
__pycache__/
*.pyc
avian-version.h
