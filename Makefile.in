# Generated into the build tree, so a read-only source tree still builds, and
# BUILT_SOURCES because every object that embeds it needs it to exist before
# the first compile rather than after.
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@OCL_KERNELS_H = cuda/ocl/avian-ocl-kernels.h
# Both shavite variants, as avian_miner_SOURCES does: sph_shavite.h redirects
# sph_shavite512_* to the AES-NI implementation when __AES__ and __SSSE3__ are
# defined and to the software one otherwise, so linking only one of them
# builds on this machine and fails on the next.
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@OCL_SPH_SOURCES = \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/jh/sph_jh.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/groestl/sph_groestl.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/shavite/sph_shavite.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/shavite/sph-shavite-aesni.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/bmw/sph_bmw.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/skein/sph_skein.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/keccak/sph_keccak.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/simd/sph_simd.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/echo/sph_echo.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/shabal/sph_shabal.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/luffa/sph_luffa.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/cubehash/sph_cubehash.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/fugue/sph_fugue.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/whirlpool/sph_whirlpool.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/sha/sph_sha2big.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/blake/sph_blake.c \
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	algo/hamsi/sph_hamsi.c

@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_selftest_SOURCES = cuda/ocl/avian-ocl-selftest.c $(OCL_SPH_SOURCES)
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_selftest_CPPFLAGS = -I$(top_srcdir) -I$(top_builddir) @OCL_CFLAGS@
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_selftest_LDFLAGS = @OCL_LDFLAGS@
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_selftest_LDADD = @OCL_LIBS@
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_batchtest_SOURCES = cuda/ocl/avian-ocl-batchtest.c $(OCL_SPH_SOURCES)
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_batchtest_CPPFLAGS = -I$(top_srcdir) -I$(top_builddir)
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@avian_ocl_batchtest_LDADD = @OCL_DL_LIBS@
all: $(BUILT_SOURCES) cpuminer-config.h
	$(MAKE) $(AM_MAKEFLAGS) all-recursive

.SUFFIXES:
.SUFFIXES: .cu .c .cpp .o .obj
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --foreign'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --foreign \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):

cpuminer-config.h: stamp-h1
	@test -f $@ || rm -f stamp-h1
	@test -f $@ || $(MAKE) $(AM_MAKEFLAGS) stamp-h1

stamp-h1: $(srcdir)/cpuminer-config.h.in $(top_builddir)/config.status
	@rm -f stamp-h1
	cd $(top_builddir) && $(SHELL) ./config.status cpuminer-config.h
$(srcdir)/cpuminer-config.h.in: @MAINTAINER_MODE_TRUE@ $(am__configure_deps) 
	($(am__cd) $(top_srcdir) && $(AUTOHEADER))
	rm -f stamp-h1
	touch $@

distclean-hdr:
	-rm -f cpuminer-config.h stamp-h1
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	      echo " $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	      $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && rm -f $$files

clean-binPROGRAMS:
	-test -z "$(bin_PROGRAMS)" || rm -f $(bin_PROGRAMS)

clean-checkPROGRAMS:
	-test -z "$(check_PROGRAMS)" || rm -f $(check_PROGRAMS)
