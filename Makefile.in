.PRECIOUS: Makefile


.PHONY: force-avian-version
$(AVIAN_VERSION_H): force-avian-version
	$(SHELL) $(top_srcdir)/scripts/mkversion.sh $@ $(top_srcdir)

$(WEBUI_PAGE_H): $(top_srcdir)/webui/index.html $(top_srcdir)/webui/mkpage.sh
	$(MKDIR_P) webui
	$(SHELL) $(top_srcdir)/webui/mkpage.sh $@

@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@%.nv.o: %.cu
@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@	@NVCC@ @NVCC_ARCH@ $(GPU_FLAGS) -Xcompiler -fPIC -c -o $@ $<

@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@%.nv.o: %.c
@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@	@NVCC@ @NVCC_ARCH@ $(GPU_FLAGS) -Xcompiler -fPIC -c -o $@ $<

@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@libavian_cuda.so: $(NV_OBJECTS)
@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@	@NVCC@ -shared -o $@ $(NV_OBJECTS) @CUDA_LDFLAGS@ @CUDA_LIBS@

# The rename shim ahead of everything else, so a kernel's
# #include <cuda_runtime.h> finds it rather than a CUDA toolkit that may be
# installed on the same machine. It is in this rule and not in GPU_FLAGS
# because an Nvidia compile must never see that directory, and with both
# vendors built the two compiles happen side by side.
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@%.amd.o: %.cu
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@	@HIPCC@ @HIPCC_ARCH@ -I$(top_srcdir)/cuda/hip $(GPU_FLAGS) -fPIC -c -o $@ $<

# -x c, which the Nvidia rule above does not need: nvcc compiles a .c file
# as C, while hipcc is clang++ and compiles it as C++, where sphlib's
# implicit void* conversions are errors. scripts/windows/build-hip-dll.ps1
# has always passed it; this rule never did, and nothing noticed because
# building the AMD backend needs a ROCm install.
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@%.amd.o: %.c
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@	@HIPCC@ @HIPCC_ARCH@ -x c -I$(top_srcdir)/cuda/hip $(GPU_CPU_FLAGS) -fPIC -c -o $@ $<

@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@libavian_amd.so: $(AMD_OBJECTS)
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@	@HIPCC@ -shared -o $@ $(AMD_OBJECTS) @HIP_LDFLAGS@ @HIP_LIBS@

@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@$(OCL_KERNELS_H): $(OCL_KERNEL_SOURCES) $(top_srcdir)/cuda/ocl/mkkernels.sh
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	$(MKDIR_P) cuda/ocl
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	$(SHELL) $(top_srcdir)/cuda/ocl/mkkernels.sh $@

@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@%.ocl.o: %.c $(OCL_KERNELS_H)
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	$(CC) $(CFLAGS) @OCL_CFLAGS@ -I$(top_srcdir) -I$(top_builddir) @OCL_PICFLAG@ -c -o $@ $<

@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@@OCL_LIB@: $(OCL_OBJECTS)
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@	$(CC) -shared -o $@ $(OCL_OBJECTS) @OCL_LDFLAGS@ @OCL_LIBS@
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@cuda/ocl/avian_ocl_selftest-avian-ocl-selftest.$(OBJEXT): $(OCL_KERNELS_H)
# It loads the backend from beside itself, so that has to exist before
# `make check` runs.
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@check-local: @OCL_LIB@

# Built by `make`, not only by `make libavian_cuda.so`, and left beside the
# binary, which is the first place the loader looks.
@HAVE_CUDA_TRUE@all-local: $(GPU_BACKENDS)

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
