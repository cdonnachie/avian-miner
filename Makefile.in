# automake has no notion of .cu, so these are compiled by an explicit rule and
# handed to the link as objects. Listed one per line rather than globbed, so
# that what is built is what is in the tree and `make dist` sees them.
@HAVE_CUDA_TRUE@CUDA_SOURCES = \
@HAVE_CUDA_TRUE@  cuda/device.cu \
@HAVE_CUDA_TRUE@  cuda/avian-cuda-support.cu \
@HAVE_CUDA_TRUE@  algo/x16/x16rt-cuda-batch.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/JHA/cuda_jha_keccak512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/cuda_checkhash.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_bmw512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_jh512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_quark_blake512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_quark_groestl512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_quark_keccak512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/quark/cuda_skein512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/qubit/qubit_luffa512_alexis.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_cubehash512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_cubehash512_80.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_echo_sp.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_luffa512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_shavite512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_shavite512_sp.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x11/cuda_x11_simd512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x13/cuda_x13_fugue512_sp.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x13/cuda_x13_hamsi512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x13/cuda_x13_hamsi512_sp.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x15/cuda_x14_shabal512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x15/cuda_x14_shabal512_sp.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x15/cuda_x15_whirlpool.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_echo512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_fugue512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_shabal512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_shavite512.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_simd512_80.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x16r/cuda_x16_whirlpool.cu \
@HAVE_CUDA_TRUE@  cuda/upstream/x17/cuda_x17_sha512.cu


# -I. and -I$(top_srcdir) find cpuminer-config.h, miner.h and compat.h;
# cuda/ finds the shim; cuda/upstream/ finds the vendored headers at the paths
# upstream's own includes expect.
@HAVE_CUDA_TRUE@GPU_INCLUDES = -I. -I$(top_srcdir) -I$(top_srcdir)/cuda -I$(top_srcdir)/cuda/upstream

# -w because the vendored kernels are not ours to make warning clean, and the
# noise would bury warnings from code that is.
#
# $(EXTRA_INCLUDES) because the kernels' host half includes miner.h, which
# includes jansson.h, and on a machine with no system jansson that header is
# the bundled one under compat/. The C sources reach it through ALL_INCLUDES
# and these rules need the same. A build host that has jansson installed never
# notices the omission, which is why it survived until the first build on one
# that does not.
#
# -DAVIAN_CUDA_BUILDING_DLL because both vendors now build a library the
# miner loads, and a loaded library cannot reach the executable's globals.
# The define is what gives the kernels their own applog, opt_debug and log
# levels instead of miner.h's. It was Windows-only when Linux linked the
# objects straight into the binary; without it here the library builds and
# then fails to load with "undefined symbol: opt_debug". The name is kept
# for the same reason HAVE_CUDA's is: two PowerShell scripts and three
# headers test it, and a rename stopping at one of them would leave the rest
# testing something different from the sources.
# Split so the two C files below can be compiled as C. Everything else
# here is C++ either way.
@HAVE_CUDA_TRUE@GPU_CPU_FLAGS = -w -DAVIAN_CUDA_BUILDING_DLL \
@HAVE_CUDA_TRUE@            $(GPU_INCLUDES) $(EXTRA_INCLUDES)

@HAVE_CUDA_TRUE@GPU_FLAGS = -std=c++14 $(GPU_CPU_FLAGS)

# One library per vendor, each exporting the same avian_cuda_* ABI, neither
# linked into the miner: it loads whichever are present at startup. So the
# two are no longer alternatives, the binary carries no vendor runtime
# dependency, and a machine with one card of each works. See
# cuda/avian-gpu-backend.h.
#
# The sources are the same for both and the objects cannot be, so each
# vendor compiles to its own suffix. Pattern rules rather than a .cu.o
# suffix rule, since a suffix rule cannot name two compilers, and they match
# across directories, which the vendored kernels need.
#
# These rules are for the make build, which means Linux. Windows cannot run
# nvcc from this Makefile at all, because nvcc insists on MSVC as its host
# compiler while the miner is MinGW, and builds its DLLs through
# scripts/windows/build-cuda-dll.ps1 and build-hip-dll.ps1 instead.
# Two sphlib files the kernels' host side calls to precompute the 80-byte
# midstates: whirlpool for its table setup and jh for jh512_setBlock_80.
# Compiled into each backend rather than called back into the miner, because
# a loaded library cannot see the executable's symbols. The Windows DLL has
# carried them from the start for the same reason; see $extraFiles in
# scripts/windows/build-cuda-dll.ps1. Through the GPU compiler, not $(CC),
# so their linkage matches the C++ kernels that call them.
@HAVE_CUDA_TRUE@GPU_CPU_SOURCES = algo/whirlpool/sph_whirlpool.c algo/jh/sph_jh.c
@HAVE_CUDA_TRUE@GPU_BACKENDS = $(am__append_8) $(am__append_9) \
@HAVE_CUDA_TRUE@	$(am__append_10)
@HAVE_CUDA_TRUE@@HAVE_GPU_NV_TRUE@NV_OBJECTS = $(CUDA_SOURCES:.cu=.nv.o) $(GPU_CPU_SOURCES:.c=.nv.o)
@HAVE_CUDA_TRUE@@HAVE_GPU_AMD_TRUE@AMD_OBJECTS = $(CUDA_SOURCES:.cu=.amd.o) $(GPU_CPU_SOURCES:.c=.amd.o)

# The host compiler and nothing else. OpenCL compiles kernels at run time, so
# this backend has no device compiler, no .cu rule and no architecture list,
# and the kernels ship as text rather than as a fatbinary.
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@OCL_OBJECTS = cuda/ocl/avian-ocl.ocl.o

# Listed rather than globbed: automake does not handle $(wildcard) in a
# dependency, and a kernel that is not listed here would not trigger a
# regenerate, so the header would go stale against its own sources.
@HAVE_CUDA_TRUE@@HAVE_GPU_OCL_TRUE@OCL_KERNEL_SOURCES = \
